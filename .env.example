# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# --- Storage -----------------------------------------------------------------
CRE_DB=cre_radar.db

# --- No API key required -----------------------------------------------------
# Extraction is a pattern parser (`heuristic.py`) and scoring is a rules file
# (`scoring.toml`). Nothing here calls a model, so there is no key to manage
# and no per-run cost. Please keep it that way.

# --- Obsidian digest ---------------------------------------------------------
# Absolute path to the vault folder the daily note is written into. It must
# already exist. Leave blank to skip writing a note.
OBSIDIAN_DIGEST_DIR=

# --- Email digest (Resend) ---------------------------------------------------
# https://resend.com/api-keys. Leave blank to skip sending; the run still
# publishes the site and writes the note.
RESEND_API_KEY=
# Must be on a domain verified in Resend.
DIGEST_FROM=digest@example.com
# Comma-separated.
DIGEST_TO=you@example.com

# --- Tuning ------------------------------------------------------------------
# Only surface items scoring at or above this (0-100).
CRE_MIN_SCORE=55
# Max items fetched per source per run.
CRE_FETCH_LIMIT=40
