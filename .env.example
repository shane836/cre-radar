# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# --- Storage -----------------------------------------------------------------
CRE_DB=cre_radar.db

# --- No API key required -----------------------------------------------------
# Extraction is a pattern parser (`heuristic.py`) and scoring is a rules file
# (`scoring.toml`). Nothing here calls a model, so there is no key to manage
# and no per-run cost. Please keep it that way.

# --- Obsidian digest ---------------------------------------------------------
# Absolute path to the vault folder the daily note is written into. It must
# already exist. Leave blank to skip writing a note.
OBSIDIAN_DIGEST_DIR=

# --- Email digest (Resend) ---------------------------------------------------
# https://resend.com/api-keys. Leave blank to skip sending; the run still
# publishes the site and writes the note.
RESEND_API_KEY=
# Must be on a domain verified in Resend.
DIGEST_FROM=digest@example.com
# Comma-separated.
DIGEST_TO=you@example.com

# --- Tuning ------------------------------------------------------------------
# Only surface items scoring at or above this (0-100).
CRE_MIN_SCORE=55
# Max items fetched per source per run.
CRE_FETCH_LIMIT=40

# --- Signup box (Vercel only, NOT here) --------------------------------------
# `api/subscribe.js` runs on Vercel, and this file is never deployed, so these
# belong in the Vercel project's environment. Listed here only so nobody has to
# go read the function to find out what it needs.
#
#   BEEHIIV_API_KEY         required. beehiiv -> Settings -> API.
#   BEEHIIV_PUBLICATION_ID  required. The cre-radar publication, `pub_...`.
#   BEEHIIV_SUBSCRIBE_URL   optional. The publication's hosted signup page,
#                           offered when a signup fails. Leave unset rather
#                           than pointing it at the firm's publication.
#   RESEND_API_KEY          optional. Emails a copy of each signup.
#   SUBSCRIBE_FROM / _TO    optional; fall back to DIGEST_FROM / DIGEST_TO.
