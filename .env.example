# --- Storage -----------------------------------------------------------------
CRE_DB=cre_radar.db

# --- No API key required ------------------------------------------------------
# Extraction and scoring are done by Claude Code (the `cre-radar` skill), or by
# the built-in pattern parser with `collect --heuristic`. Nothing here calls a
# paid API, so there is no key to manage and no per-run token bill.

# --- Obsidian digest ---------------------------------------------------------
# Folder the daily digest note is written into. Must already exist.
OBSIDIAN_DIGEST_DIR=/Users/shanemason/Mason Equity Dropbox/0. Team Folder MEP/2026. TEAM FOLDER MEP/MEP Vault/Reference/CRE Radar

# --- Email digest (Resend) ---------------------------------------------------
# Copy the key from sf-events-aggregator/.env.local
RESEND_API_KEY=
DIGEST_FROM=cre-radar@masonequitypartners.com
DIGEST_TO=shane@masonequitypartners.com

# --- Tuning ------------------------------------------------------------------
# Only surface items scoring at or above this (0-100).
CRE_MIN_SCORE=55
# Max items fetched per source per run.
CRE_FETCH_LIMIT=40
