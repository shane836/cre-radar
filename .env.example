# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# --- Storage -----------------------------------------------------------------
CRE_DB=cre_radar.db

# --- No API key required -----------------------------------------------------
# Extraction is a pattern parser (`heuristic.py`) and scoring is a rules file
# (`scoring.toml`). Nothing here calls a model, so there is no key to manage
# and no per-run cost. Please keep it that way.

# --- Obsidian digest ---------------------------------------------------------
# Absolute path to the vault folder the daily note is written into. It must
# already exist. Leave blank to skip writing a note.
OBSIDIAN_DIGEST_DIR=

# --- Email digest (Resend) ---------------------------------------------------
# https://resend.com/api-keys. Leave blank to skip sending; the run still
# publishes the site and writes the note.
RESEND_API_KEY=
# Must be on a domain verified in Resend.
DIGEST_FROM=digest@example.com
# Comma-separated.
DIGEST_TO=you@example.com

# --- Public newsletter (MailerLite) ------------------------------------------
# The weekly issue that goes to subscribers. Separate from the digest above in
# every way: a different transport, a different audience, and a weekly rather
# than daily cadence. Leave MAILERLITE_API_KEY blank to skip it entirely; the
# daily run still collects, publishes and delivers.
#
# MailerLite rather than Resend or beehiiv: the firm already authenticates and
# warms `news.masonequitypartners.com` there, and a second provider would mean
# a second sending domain and a second warm-up.
MAILERLITE_API_KEY=
# The cre-radar group, NOT the associates one. The campaign is scoped to a
# group; without this it would go to the whole account.
MAILERLITE_GROUP_ID=
# Must be on a domain MailerLite has authenticated.
NEWSLETTER_FROM=
NEWSLETTER_FROM_NAME=
# Which weekday the issue goes out. The daily run calls the command every day
# and this gate is what makes it weekly.
NEWSLETTER_DAY=thursday
# How far ahead the issue looks.
NEWSLETTER_HORIZON_DAYS=14
# Bulk mail is required to carry a physical address. Blank omits the line —
# fill it before the first real send.
NEWSLETTER_POSTAL_ADDRESS=

# --- Tuning ------------------------------------------------------------------
# Only surface items scoring at or above this (0-100).
CRE_MIN_SCORE=55
# Max items fetched per source per run.
CRE_FETCH_LIMIT=40

# --- Signup box (Vercel only, NOT here) --------------------------------------
# `api/subscribe.js` runs on Vercel, and this file is never deployed, so these
# belong in the Vercel project's environment. Listed here only so nobody has to
# go read the function to find out what it needs.
#
#   MAILERLITE_API_KEY      required. MailerLite -> Integrations -> API. Same
#                           group the newsletter sends to, or a signup lands
#                           somewhere nothing mails.
#   MAILERLITE_GROUP_ID     required. The cre-radar group, NOT the associates one.
#   BEEHIIV_API_KEY         optional, transitional. Mirrors the signup to the
#                           old beehiiv list. Delete both BEEHIIV_ variables
#                           once the existing subscribers are moved across and
#                           the mirror retires itself, no code change needed.
#   BEEHIIV_PUBLICATION_ID  optional, transitional. As above.
#   BEEHIIV_SUBSCRIBE_URL   optional. A hosted signup page, offered when a
#                           signup fails. Leave unset rather than pointing it
#                           at the firm's publication.
#   RESEND_API_KEY          optional. Emails a copy of each signup.
#   SUBSCRIBE_FROM / _TO    optional; fall back to DIGEST_FROM / DIGEST_TO.
