# Only the generated page and `api/` ship. Everything below is how the page
# gets built, and leaving pyproject.toml in makes Vercel try to build a Python
# app. `api/subscribe.js` has no dependencies, so it needs nothing from here.
src/
tests/
fixtures/
rubrics/
scripts/
docs/
assets/
pyproject.toml
uv.lock
.venv/
*.db
*.db.bak
*.toml
!vercel.json
*.md
.env
.env.example
cron.log
cron.log.*
launchd.log
.run.lock

# Local mockups. Never part of the deploy.
*.jpg
*.png
# ...except the link-preview card, which is the one image that must be a real
# fetchable file rather than a data URI. `publish` copies it into `public/`,
# and without this negation the blanket `*.png` above silently drops it and
# every preview renders with no image. Cost one deploy to find, 10 Sep 2026.
!public/og-card.png
navbar-*.html
